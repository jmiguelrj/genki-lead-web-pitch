---
// @genki-alias: [GENKI-SITE-LAYOUT]
import '@genki-pitch/ui/tokens.scss';
import { Button } from '@genki-pitch/ui';
import styles from './BaseLayout.module.scss';

export interface Props {
  readonly title: string;
  readonly description: string;
}

const { title, description } = Astro.props;
const repoUrl = 'https://github.com/jmiguelrj/genki-lead-web-pitch';
const canonicalUrl = 'https://genki-lead-web-pitch.pages.dev/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0d7554" />
  </head>
  <body class={styles.page}>
    <a href="#main-content" class={styles.skipLink}>Skip to main content</a>
    <header class={styles.header}>
      <nav class={styles.navInner} aria-label="Primary architecture navigation">
        <div class={styles.brandRow}>
          <div class={styles.brandGroup}>
            <a href="#" class={styles.brandLink}>
              <span class={styles.brandMark} aria-hidden="true"></span>
              <span class={styles.brandTitle}>Genki · Lead Web Pitch</span>
            </a>
            <span class={styles.authorPill}>João Miguel · UTC-3</span>
          </div>
          <div class={styles.mobileCta}>
            <Button href={repoUrl} external variant="secondary" size="sm">
              GitHub ↗
            </Button>
          </div>
        </div>
        <div class={styles.navActions}>
          <div class={styles.navLinks}>
            <a href="#blueprints" class={styles.navLink}>01 · Blueprints</a>
            <a href="#agent-guardrails" class={styles.navLink}>02 · AI Guardrails</a>
            <a href="#claim-preflight" class={styles.navLink}>03 · Claim OS UX</a>
            <a href="#track-record" class={styles.navLink}>Track Record</a>
          </div>
          <div class={styles.desktopCta}>
            <Button href={repoUrl} external variant="secondary" size="sm">
              GitHub ↗
            </Button>
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content" class={styles.main}>
      <slot />
    </main>

    <div class={styles.bottomBar}>
      <div class={styles.bottomInner}>
        <span>@genki-pitch/site · Astro Static Shell + React 19 Islands + SCSS Token Guardrails</span>
        <span>Built for Genki · Cologne (CET) ↔ Rio de Janeiro (UTC-3)</span>
      </div>
    </div>
  </body>
</html>
